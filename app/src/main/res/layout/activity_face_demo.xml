<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".FaceDemoActivity">

    <!-- 标题 -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- SDK 状态 -->
    <TextView
        android:id="@+id/tvSdkStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/status_initializing"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="8dp"/>

    <!-- 已录入人数 -->
    <TextView
        android:id="@+id/tvEnrolledCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/enrolled_count"
        android:textSize="14sp"
        android:textColor="#333333"
        android:layout_marginBottom="16dp"/>

    <!-- 工号输入 -->
    <EditText
        android:id="@+id/etWorkId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/work_id_hint"
        android:inputType="number"
        android:singleLine="true"
        android:layout_marginBottom="12dp"/>

    <!-- 姓名输入 -->
    <EditText
        android:id="@+id/etName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/name_hint"
        android:inputType="textPersonName"
        android:singleLine="true"
        android:layout_marginBottom="24dp"/>

    <!-- 录入人脸按钮 -->
    <Button
        android:id="@+id/btnEnroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/enroll_button"
        android:layout_marginBottom="12dp"/>

    <!-- 识别人脸按钮 -->
    <Button
        android:id="@+id/btnRecognize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/recognize_button"
        android:layout_marginBottom="12dp"/>

    <!-- 清空数据按钮 -->
    <Button
        android:id="@+id/btnClear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/clear_button"
        android:backgroundTint="@color/colorPrimary"
        android:layout_marginBottom="24dp"/>

    <!-- 进度条 -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:indeterminate="true"
        android:layout_marginBottom="12dp"/>

    <!-- 状态信息 -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/status_waiting"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="16dp"/>

    <!-- 结果显示 -->
    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/result_label"
        android:textSize="16sp"
        android:textColor="#000000"
        android:minHeight="80dp"
        android:padding="8dp"
        android:background="#F5F5F5"/>

</LinearLayout>
